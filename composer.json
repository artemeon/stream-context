{
  "name": "artemeon/stream-context",
  "version": "0.1.1",
  "license": "MIT",
  "type": "library",
  "description": "Library to create a stream context",
  "keywords": [
    "stream",
    "context"
  ],
  "scripts": {
    "test": "./vendor/bin/pest --mutate",
    "test:coverage": "XDEBUG_MODE=coverage ./vendor/bin/pest --coverage --min=60",
    "test:type-coverage": "./vendor/bin/pest --type-coverage --min=100",
    "phpstan": "php ./vendor/bin/phpstan analyse --memory-limit=4G"
  },
  "authors": [
    {
      "name": "Dietmar Simons",
      "email": "dietmar.simons@artemeon.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Artemeon\\StreamContext\\": "src/"
    }
  },
  "require": {
    "php": ">=8.4",
    "phpseclib/phpseclib": "~3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20.0",
    "mockery/mockery": "^1.6.12",
    "phpstan/phpstan": "^2.1.2",
    "rector/rector": "^2.0.7",
    "pestphp/pest": "^3.7",
    "pestphp/pest-plugin-type-coverage": "^3.2",
    "pestphp/pest-plugin-faker": "^3.0",
    "pestphp/pest-plugin-watch": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
